{
  "name": "backoffice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../backend/Sources/APIContract/openapi.yaml -o src/api/schema.d.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "prebuild": "npm run gen:api",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run gen:api",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@testing-library/vue": {
      "@testing-library/dom": "^10.4.0"
    }
  }
}
