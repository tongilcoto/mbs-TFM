      "replace": "seasonId: \"\\(id)\",",
      "filter": "CompetitionEndpointTests"
    },
    {
      "id": "E1-modality",
      "description": "fútbol 7 del contrato se traduce a fútbol 5",
      "file": "Sources/HTTPAdapter/CompetitionHandler.swift",
      "find": "case .futbol_7: .futbol7",
      "replace": "case .futbol_7: .futbol5",
