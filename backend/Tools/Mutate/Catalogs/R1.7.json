      "description": "la consulta ignora seasonId",
      "file": "Sources/Persistence/FluentCompetitionRepository.swift",
      "find": "if let seasonID = filter.seasonID { query.filter(\\.$season.$id == seasonID.raw) }",
      "replace": "",
      "filter": "CompetitionPersistenceTests"
    },
    {
      "id": "P2-modality",
      "description": "la consulta ignora modality",
      "file": "Sources/Persistence/FluentCompetitionRepository.swift",
      "find": "if let modality = filter.modality { query.filter(\\.$modality == modality.rawValue) }",
      "replace": "",
      "filter": "CompetitionPersistenceTests"
    },
    {
      "id": "P3-age",
      "description": "la consulta ignora ageCategory",
      "file": "Sources/Persistence/FluentCompetitionRepository.swift",
      "find": "if let ageCategory = filter.ageCategory { query.filter(\\.$ageCategory == ageCategory.rawValue) }",
      "replace": "",
      "filter": "CompetitionPersistenceTests"
    },
    {
      "id": "P4-gender",
      "description": "la consulta ignora gender",
      "file": "Sources/Persistence/FluentCompetitionRepository.swift",
      "find": "if let gender = filter.gender { query.filter(\\.$gender == gender.rawValue) }",
      "replace": "",
      "filter": "CompetitionPersistenceTests"
    },
    {
