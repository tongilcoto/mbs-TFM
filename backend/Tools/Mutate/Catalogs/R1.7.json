      "replace": "seasonID: nil,",
      "filter": "CompetitionEndpointTests"
    },
    {
      "id": "H2-modality",
      "description": "el handler no pasa modality",
      "file": "Sources/HTTPAdapter/CompetitionHandler.swift",
      "find": "modality: query.modality?.toDomain(),",
      "replace": "modality: nil,",
      "filter": "CompetitionEndpointTests"
    },
    {
      "id": "H3-age",
      "description": "el handler no pasa ageCategory",
      "file": "Sources/HTTPAdapter/CompetitionHandler.swift",
      "find": "ageCategory: query.ageCategory?.toDomain(),",
      "replace": "ageCategory: nil,",
      "filter": "CompetitionEndpointTests"
    },
    {
      "id": "H4-gender",
      "description": "el handler no pasa gender",
      "file": "Sources/HTTPAdapter/CompetitionHandler.swift",
      "find": "gender: query.gender?.toDomain())",
      "replace": "gender: nil)",
      "filter": "CompetitionEndpointTests"
    },
    {
      "id": "H5-400",
      "description": "una seasonId que no es UUID da 200 vacío",
      "file": "Sources/HTTPAdapter/CompetitionHandler.swift",
      "find": "return .badRequest(Self.invalidUUID(error))",
      "replace": "return .ok(.init(body: .json([])))",
      "filter": "CompetitionEndpointTests"
    },
    {
      "id": "H6-codes",
      "description": "los dos códigos de la federación cruzados",
